{% style %}
  .wol-about {
    padding: clamp(5rem, 9vw, 11rem) 0 clamp(4rem, 7vw, 8rem);
  }

  .wol-about__grid {
    display: grid;
    gap: 2.8rem;
    align-items: start;
  }

  .wol-about__eyebrow {
    margin: 0 0 1.4rem;
    color: rgb(var(--color-foreground));
    font-family: 'Montserrat', var(--font-heading-family);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .wol-about__heading {
    margin: 0;
    max-width: 10ch;
    color: rgb(var(--color-foreground));
    line-height: 0.92;
    text-wrap: balance;
  }

  .wol-about__body {
    max-width: 58rem;
    font-size: 1.7rem;
    line-height: 1.75;
    color: inherit;
  }

  .wol-about__body p:first-child {
    margin-top: 0;
  }

  @media screen and (max-width: 749px) {
    .wol-about__grid {
      text-align: center;
    }

    .wol-about__heading,
    .wol-about__body {
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media screen and (min-width: 750px) {
    .wol-about__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: clamp(4rem, 8vw, 12rem);
    }
  }
{% endstyle %}

<section class="wol-about color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width wol-about__grid">
    <div>
      <p class="wol-about__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="wol-about__heading h0">{{ section.settings.heading | escape }}</h1>
    </div>
    <div class="wol-about__body rte">
      {{ section.settings.body }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "WOL about",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A little piece of Pakistan"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stories worth sending."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Story",
      "default": "<p>West Of Lahore makes souvenirs for people who carry Pakistan with them, wherever they go.</p><p>Our postcard collections celebrate the cities, sayings, poetry and small everyday details that make a place feel like home.</p><p>Designed by an expat himself, these souveniers are to be sent, kept, pinned up and passed on.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "WOL about"
    }
  ]
}
{% endschema %}
