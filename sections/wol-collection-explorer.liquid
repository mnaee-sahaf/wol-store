{% liquid
  assign section_heading = section.settings.heading
%}

<section class="wol-collections color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width wol-collections__inner">
    <div class="wol-collections__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="wol-collections__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section_heading != blank %}
        <h2 class="wol-collections__heading {{ section.settings.heading_size }}">{{ section_heading | escape }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="wol-collections__description rte">{{ section.settings.description }}</div>
      {% endif %}
    </div>

    <div class="wol-collections__grid" role="list">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        {% if collection == blank %}
          {% continue %}
        {% endif %}
        <a
          class="wol-collections__card"
          href="{{ collection.url }}"
          {{ block.shopify_attributes }}
          role="listitem"
        >
          <div class="wol-collections__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', alt: block.settings.title }}
            {% elsif collection.featured_image != blank %}
              {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', alt: collection.title }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <div class="wol-collections__content">
            <p class="wol-collections__number">0{{ forloop.index }}</p>
            <h3>{{ block.settings.title | default: collection.title | default: 'Postcard collection' | escape }}</h3>
            {% if block.settings.description != blank %}
              <p>{{ block.settings.description | escape }}</p>
            {% endif %}
            <span class="wol-collections__link">{{ block.settings.link_label | default: 'Explore the collection' | escape }} <span aria-hidden="true">&rarr;</span></span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .wol-collections {
    overflow: hidden;
    padding: clamp(4rem, 8vw, 9rem) 0;
  }

  .wol-collections__inner {
    display: grid;
    gap: 3.2rem;
  }

  .wol-collections__intro {
    max-width: 62rem;
  }

  .wol-collections__eyebrow,
  .wol-collections__number {
    margin: 0 0 1rem;
    color: rgb(var(--color-foreground));
    font-family: var(--font-heading-family);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: .14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .wol-collections__heading {
    margin: 0;
    line-height: .95;
  }

  .wol-collections__description {
    max-width: 52rem;
    margin-top: 1.6rem;
  }

  .wol-collections__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .wol-collections__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: rgb(var(--color-foreground));
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), .18);
    text-decoration: none;
    transition: transform .25s ease, box-shadow .25s ease;
  }

  .wol-collections__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: rgba(var(--color-foreground), .06);
  }

  .wol-collections__media img,
  .wol-collections__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .35s ease;
  }

  .wol-collections__content {
    display: grid;
    align-content: start;
    min-height: 18rem;
    padding: 1.8rem;
  }

  .wol-collections__content h3 {
    margin: 0;
    font-size: clamp(1.9rem, 3vw, 3.2rem);
    line-height: 1;
  }

  .wol-collections__content > p:not(.wol-collections__number) {
    margin: 1rem 0 1.8rem;
    font-size: 1.4rem;
    line-height: 1.35;
  }

  .wol-collections__link {
    align-self: end;
    margin-top: auto;
    font-family: var(--font-heading-family);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  @media (hover: hover) {
    .wol-collections__card:hover {
      transform: translateY(-.4rem);
      box-shadow: .8rem .8rem 0 rgba(var(--color-foreground), .14);
    }

    .wol-collections__card:hover .wol-collections__media img {
      transform: scale(1.04);
    }
  }

  @media screen and (min-width: 750px) {
    .wol-collections__inner {
      grid-template-columns: minmax(18rem, .7fr) minmax(0, 2fr);
      align-items: start;
      gap: clamp(4rem, 8vw, 10rem);
    }

    .wol-collections__intro {
      position: sticky;
      top: 3rem;
    }

    .wol-collections__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.4rem;
    }

    .wol-collections__content {
      min-height: 19rem;
      padding: 2.4rem;
    }
  }
</style>

{% schema %}
{
  "name": "WOL collection explorer",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pick a post"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Small cards, big stories."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h0"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Collect a little piece of Pakistan, one postcard at a time.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Explore the collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "WOL collection explorer",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "title": "Poetry inspired",
            "description": "Words by Ghalib, Faraz and Iqbal, ready to send.",
            "link_label": "Read the cards"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Pakistan, in facts",
            "description": "Tiny lessons about the things that make us us.",
            "link_label": "Know more"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "City travel guides",
            "description": "A traveller's love letter to Lahore and beyond.",
            "link_label": "Take the tour"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "For the culture",
            "description": "Quirky sayings, inside jokes and everyday desi energy.",
            "link_label": "See the collection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
