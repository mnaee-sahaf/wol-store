{% liquid
  assign image = section.settings.image
%}

<section class="wol-brand-hero color-{{ section.settings.color_scheme }} gradient{% if image != blank %} wol-brand-hero--with-image{% endif %}">
  <div class="page-width wol-brand-hero__shell">
    {% if image != blank %}
      <div class="wol-brand-hero__media">
        {{ image | image_url: width: 2400 | image_tag: class: 'wol-brand-hero__image', widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt }}
      </div>
    {% endif %}

    <div class="wol-brand-hero__content">
      <p class="wol-brand-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="wol-brand-hero__heading">{{ section.settings.heading | escape }}</h1>
      <div class="wol-brand-hero__body rte">{{ section.settings.body }}</div>
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .wol-brand-hero { overflow: hidden; padding: clamp(4rem, 9vw, 10rem) 0; }
  .wol-brand-hero__shell { position: relative; min-height: min(70rem, 52vw); }
  .wol-brand-hero__media { position: absolute; inset: 0; }
  .wol-brand-hero__image { display: block; width: 100%; height: 100%; object-fit: cover; object-position: right center; }
  .wol-brand-hero__content {
    position: relative; z-index: 1; display: grid; align-content: center; width: min(100%, 55rem);
    min-height: min(70rem, 52vw); padding: clamp(2.4rem, 5vw, 7rem) 0;
  }
  .wol-brand-hero__eyebrow {
    margin: 0 0 1.6rem; color: rgb(var(--color-foreground)); font-family: var(--font-heading-family);
    font-size: 1.2rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
  }
  .wol-brand-hero__heading { margin: 0; font-size: clamp(4.6rem, 8vw, 10rem); line-height: .84; letter-spacing: -.045em; }
  .wol-brand-hero__body { max-width: 44rem; margin-top: 2.4rem; font-size: clamp(1.6rem, 2vw, 2rem); line-height: 1.5; }
  .wol-brand-hero__body p { margin: 0 0 1.2rem; }
  .wol-brand-hero__body + .button { margin-top: 1.8rem; justify-self: start; }
  .wol-brand-hero:not(.wol-brand-hero--with-image) .wol-brand-hero__shell,
  .wol-brand-hero:not(.wol-brand-hero--with-image) .wol-brand-hero__content { min-height: auto; }
  @media screen and (max-width: 749px) {
    .wol-brand-hero { padding: 0 0 4.8rem; }
    .wol-brand-hero__shell { display: flex; flex-direction: column; min-height: auto; }
    .wol-brand-hero__media { position: relative; order: 0; aspect-ratio: 4 / 3; }
    .wol-brand-hero__image { object-position: right center; }
    .wol-brand-hero__content { order: 1; width: 100%; min-height: auto; padding: 3.2rem 2rem 0; }
    .wol-brand-hero__heading { font-size: clamp(4.6rem, 16vw, 7rem); }
  }
</style>

{% schema %}
{
  "name": "WOL brand hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"image_picker","id":"image","label":"Hero image"},
    {"type":"text","id":"image_alt","label":"Image alt text","default":"West Of Lahore illustrated postcard collection"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"A little piece of Pakistan"},
    {"type":"text","id":"heading","label":"Heading","default":"Stories worth sending."},
    {"type":"richtext","id":"body","label":"Text","default":"<p>West Of Lahore makes souvenirs for people who carry Pakistan with them, wherever they go.</p><p>Our postcard collections celebrate cities, sayings, poetry, and the small everyday details that make a place feel like home.</p><p>Designed to be sent, kept, pinned up, and passed on.</p>"},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop the postcards"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"}
  ],
  "presets":[{"name":"WOL brand hero"}]
}
{% endschema %}